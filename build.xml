<project>
    <target name="clean">
        <delete dir=".target/classes" />
    </target>
    <target name="editor" depends="engine">
        <mkdir dir=".target/classes" />
        <javac srcdir="editor" classpath=".target/classes" destdir=".target/classes" includeantruntime="false" >
            <compilerarg value="-processor" />
            <compilerarg value="dev.levia.jimi.util.proces.CallbackProcessor" />
            <compilerarg value="-XprintProcessorInfo" />
            <compilerarg value="-XprintRounds" />
            <compilerarg value="-Xlint:processing" />
        </javac>
    </target>
    <target name="engine" depends="util">
        <mkdir dir=".target/classes" />
        <javac srcdir="engine" classpath=".target/classes" destdir=".target/classes" includeantruntime="false" >
            <compilerarg value="-processor" />
            <compilerarg value="dev.levia.jimi.util.proces.CallbackProcessor" />
            <compilerarg value="-XprintProcessorInfo" />
            <compilerarg value="-XprintRounds" />
            <compilerarg value="-Xlint:processing" />
        </javac>
    </target>
    <target name="util" depends="clean">
        <mkdir dir=".target/gen" />
        <mkdir dir=".target/classes" />
        <javac srcdir="util/anot" classpath=".target/classes" destdir=".target/classes" includeantruntime="false" />
        <javac srcdir="util/proces" classpath=".target/classes" destdir=".target/classes" includeantruntime="false" />
        <javac srcdir="util/trans" destdir=".target/classes" classpath=".target/classes" includeantruntime="true" >
            <compilerarg value="-processor" />
            <compilerarg value="dev.levia.jimi.util.proces.LibraryProcessor" />
            <compilerarg value="-s" />
            <compilerarg value=".target/gen" />
            <!--
            <compilerarg value="-XprintProcessorInfo"/>
            <compilerarg value="-XprintRounds"/>
            <compilerarg value="-Xlint:processing"/>
            -->
        </javac>
        <javac srcdir=".target/gen" classpath=".target/classes" destdir=".target/classes" includeantruntime="false" />
    </target>
    <target name="run" depends="editor">
        <java classname="dev.levia.jimi.editor.Editor" classpath=".target/classes" fork="true" >
            <jvmarg value="--enable-native-access=ALL-UNNAMED" />
        </java>
    </target>

    <target name="jar">
        <mkdir dir=".target/jar" />
        <jar destfile=".target/jar/Jimi.jar" basedir=".target/classes">
            <zipgroupfileset dir="lib" includes="*.jar" />
            <manifest>
                <attribute name="Main-Class" value="dev.levia.jimi.editor.Editor" />
            </manifest>
        </jar>
    </target>
    <!-- STEP 2: Unified Odin + Java Compilation Target -->
    <target name="odin" depends="util">
        <mkdir dir=".target/libs" />
        <!-- 2a. Compile Odin Package into Shared Library -->
        <exec executable="odin" failonerror="true">
            <arg value="build" />
            <arg value="render_odin" />
            <arg value="-out:.target/libs/render_odin.so"/>
        </exec>
        <javac srcdir=".target/gen" classpath=".target/classes" destdir=".target/classes" includeantruntime="false" />
    </target>
</project>
